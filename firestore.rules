rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Customers' saved order forms. Verified emails only (Google sign-in): an unverified
    // email/password account must not be able to claim someone else's address.
    match /requisitions/{email} {
      allow read, write: if request.auth != null && request.auth.token.get('email_verified', false) == true
        && request.auth.token.email == email;
    }

    // Google sign-in (backup) for these emails, or an admin ID + password session issued by
    // the Worker (custom token with sb_user) while that ID is switched on and the session
    // started after its last password change.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('email', '') in ['sharhanbroilerplant@gmail.com', 'waseemshaikh597@gmail.com',
                                                'bagbanhanif@gmail.com', 'farixashk06@gmail.com']
        || (request.auth.token.get('sb_user', '') != '' && staffActive()));
    }

    function staffActive() {
      let u = get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data;
      return u.get('active', false) == true && request.auth.token.auth_time >= u.get('validAfter', 0);
    }

    // Admin IDs and password hashes: only the Worker (service account) reads or writes them.
    match /admin_users/{docId} {
      allow read, write: if false;
    }

    // Who is signed in, as written in activity_log.user: the admin ID, or the Google email.
    function actor() {
      return request.auth.token.get('sb_user', '') != '' ? request.auth.token.sb_user : request.auth.token.get('email', '');
    }

    // Who may see and set customer rates (RATE_ADMINS in admin.html shows or hides the tab).
    function canSetRates() {
      return hasRight('rates');
    }

    // User rights (Admin → Users → Rights): admin_rights/{admin ID or Google email} = {rights: [areas]}.
    // The main admin and the owner's emails have every right. Someone without an entry keeps the
    // access they had before rights existed (RIGHTS_DEFAULT in admin.html, the Worker's rightsOf).
    function rightsPath() {
      return /databases/$(database)/documents/admin_rights/$(actor());
    }
    function hasRight(area) {
      return isManager() || (isAdmin() && (
        (exists(rightsPath()) && area in get(rightsPath()).data.get('rights', []))
        || (!exists(rightsPath()) && (area in ['send', 'inbox', 'credit', 'products', 'whatsapp', 'orders', 'website']
            || (area in ['rates', 'visitors'] && actor() in ['admin', 'hanif', 'sharhanbroilerplant@gmail.com', 'waseemshaikh597@gmail.com', 'bagbanhanif@gmail.com'])))));
    }
    match /admin_rights/{who} {
      allow read: if isManager() || (isAdmin() && who == actor());
      allow write: if isManager() && request.resource.data.keys().hasOnly(['rights', 'updatedAt', 'updatedBy'])
        && request.resource.data.rights is list && request.resource.data.rights.size() <= 20;
      allow delete: if isManager();
    }

    // The main admin ID, or the owner's Google emails (business email, and the old personal one).
    function isManager() {
      return isAdmin() && (request.auth.token.get('sb_role', '') == 'main'
        || request.auth.token.get('email', '') in ['sharhanbroilerplant@gmail.com', 'waseemshaikh597@gmail.com']);
    }

    // Who changed what. Every admin adds entries for their own saves (their own name, the
    // server's time); nobody can change or delete them. Only the main admin reads them.
    match /activity_log/{docId} {
      allow read: if isManager();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['at', 'user', 'name', 'area', 'action', 'changes'])
        && request.resource.data.user == actor()
        && request.resource.data.at == request.time
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.area is string && request.resource.data.area.size() <= 60
        && request.resource.data.action is string && request.resource.data.action.size() <= 600
        && request.resource.data.changes is list && request.resource.data.changes.size() <= 40;
      allow update, delete: if false;
    }

    // Someone who replied STOP (unsubscribed: true, set by the Worker) can't be ticked,
    // re-subscribed or deleted from the admin; only their own "START" undoes it.
    match /whatsapp_customers/{docId} {
      allow read: if hasRight('send') || hasRight('rates');
      allow create: if hasRight('send') && request.resource.data.get('unsubscribed', false) == false;
      allow update: if hasRight('send') && (resource.data.get('unsubscribed', false) != true
        || (request.resource.data.get('unsubscribed', false) == true && request.resource.data.get('send', false) == false));
      allow delete: if hasRight('send') && resource.data.get('unsubscribed', false) != true;
    }
    match /whatsapp_inbox/{docId} {
      allow read: if hasRight('inbox') || hasRight('send');
      allow write: if false; // only the Cloudflare Worker (service account) writes here
    }
    // What we sent each customer, for the Inbox chat view: written by the Worker only.
    match /whatsapp_chat/{docId} {
      allow read: if hasRight('inbox') || hasRight('send');
      allow write: if false;
    }
    match /whatsapp_send_log/{docId} {
      allow read: if hasRight('send');
      allow write: if false; // only the Cloudflare Worker (service account) writes here
    }
    match /whatsapp_status_log/{docId} {
      allow read: if hasRight('send');
      allow write: if false;
    }

    // Public product pages (?item=...) read the catalogue; Products (and Send, for its photo cards) edit it.
    match /catalogue/{slug} {
      allow read: if true;
      allow write: if (hasRight('products') || hasRight('send'))
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.spec is string && request.resource.data.spec.size() <= 160;
      allow delete: if hasRight('products');
    }
    // Editable homepage content (slides, about, categories, packs...). Public read.
    // main: Website; orders + form: Order form; payment: Credit (bank QR).
    match /site_content/{docId} {
      allow read: if true;
      allow write: if (docId == 'main' && hasRight('website'))
        || (docId in ['orders', 'form'] && hasRight('orders'))
        || (docId == 'form' && hasRight('rates'))
        || (docId == 'payment' && hasRight('credit'))
        || isManager();
    }
    // Credit applications (customer details + which KYC photos were sent) - created by the
    // Worker; admins read them and record approve / reject.
    // Customers who sent the order form - written by the Worker, read by admins.
    match /form_customers/{mobile} {
      allow read: if canSetRates();
      allow write: if false;
    }
    // Item rates per customer: admins only. The order form gets one number's rates from the Worker.
    match /customer_rates/{mobile} {
      allow read, write: if canSetRates();
    }
    // Daily-rate pricing: rate_settings/today (paper + S.K. Patel lifting rate) and rate_settings/formulas.
    // Business-sensitive: rate admins only. The Worker works out each daily customer's prices.
    match /rate_settings/{docId} {
      allow read, write: if canSetRates();
    }
    // Website visits (Admin → Visitors): written only by the Worker (/track); the rate admins read them.
    match /site_visits/{sid} {
      allow read: if hasRight('visitors');
      allow write: if false;
    }
    match /credit_applications/{mobile} {
      allow read, update: if hasRight('credit');
      allow create, delete: if false;
    }
    // Admin switches (e.g. settings/whatsapp.autoReply) - read by the Worker.
    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if (docId == 'whatsapp' && (hasRight('send') || hasRight('whatsapp')))
        || (docId == 'credit' && hasRight('credit'))
        || isManager();
    }
    // Last automatic catalogue reply per phone number - written by the Worker only.
    match /whatsapp_autoreply/{phone} {
      allow read: if hasRight('whatsapp') || hasRight('send');
      allow write: if false;
    }
    // Which WhatsApp templates are live / pending - written by the Worker only.
    match /catalogue_meta/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
