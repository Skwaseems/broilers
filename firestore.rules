rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Customers' saved order forms. Verified emails only (Google sign-in): an unverified
    // email/password account must not be able to claim someone else's address.
    match /requisitions/{email} {
      allow read, write: if request.auth != null && request.auth.token.get('email_verified', false) == true
        && request.auth.token.email == email;
    }

    // Google sign-in (backup) for these emails, or an admin ID + password session issued by
    // the Worker (custom token with sb_user) while that ID is switched on and the session
    // started after its last password change.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('email', '') in ['waseemshaikh597@gmail.com', 'sadiyanalband16@gmail.com',
                                                'bagbanhanif@gmail.com', 'farixashk06@gmail.com']
        || (request.auth.token.get('sb_user', '') != '' && staffActive()));
    }

    function staffActive() {
      let u = get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data;
      return u.get('active', false) == true && request.auth.token.auth_time >= u.get('validAfter', 0);
    }

    // Admin IDs and password hashes: only the Worker (service account) reads or writes them.
    match /admin_users/{docId} {
      allow read, write: if false;
    }

    // Who is signed in, as written in activity_log.user: the admin ID, or the Google email.
    function actor() {
      return request.auth.token.get('sb_user', '') != '' ? request.auth.token.sb_user : request.auth.token.get('email', '');
    }

    // The main admin ID, or the owner's Google email.
    function isManager() {
      return isAdmin() && (request.auth.token.get('sb_role', '') == 'main'
        || request.auth.token.get('email', '') == 'waseemshaikh597@gmail.com');
    }

    // Who changed what. Every admin adds entries for their own saves (their own name, the
    // server's time); nobody can change or delete them. Only the main admin reads them.
    match /activity_log/{docId} {
      allow read: if isManager();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['at', 'user', 'name', 'area', 'action', 'changes'])
        && request.resource.data.user == actor()
        && request.resource.data.at == request.time
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.area is string && request.resource.data.area.size() <= 60
        && request.resource.data.action is string && request.resource.data.action.size() <= 600
        && request.resource.data.changes is list && request.resource.data.changes.size() <= 40;
      allow update, delete: if false;
    }

    // Someone who replied STOP (unsubscribed: true, set by the Worker) can't be ticked,
    // re-subscribed or deleted from the admin; only their own "START" undoes it.
    match /whatsapp_customers/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.get('unsubscribed', false) == false;
      allow update: if isAdmin() && (resource.data.get('unsubscribed', false) != true
        || (request.resource.data.get('unsubscribed', false) == true && request.resource.data.get('send', false) == false));
      allow delete: if isAdmin() && resource.data.get('unsubscribed', false) != true;
    }
    match /whatsapp_inbox/{docId} {
      allow read: if isAdmin();
      allow write: if false; // only the Cloudflare Worker (service account) writes here
    }
    match /whatsapp_send_log/{docId} {
      allow read: if isAdmin();
      allow write: if false; // only the Cloudflare Worker (service account) writes here
    }
    match /whatsapp_status_log/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Public product pages (?item=...) read the catalogue; only admins edit it.
    match /catalogue/{slug} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.spec is string && request.resource.data.spec.size() <= 160;
      allow delete: if isAdmin();
    }
    // Editable homepage content (slides, about, categories, packs...). Public read.
    match /site_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Credit applications (customer details + which KYC photos were sent) - created by the
    // Worker; admins read them and record approve / reject.
    match /credit_applications/{mobile} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }
    // Admin switches (e.g. settings/whatsapp.autoReply) - read by the Worker.
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }
    // Last automatic catalogue reply per phone number - written by the Worker only.
    match /whatsapp_autoreply/{phone} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Which WhatsApp templates are live / pending - written by the Worker only.
    match /catalogue_meta/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
