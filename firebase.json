{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/p/:slug", "destination": "https://sharhan-broilers.pages.dev/p/:slug", "type": 302 }
    ]
  }
}
